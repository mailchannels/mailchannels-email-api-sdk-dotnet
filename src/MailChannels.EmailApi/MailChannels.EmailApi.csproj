<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo> <!-- setting GenerateAssemblyInfo to false causes this bug https://github.com/dotnet/project-system/issues/3934 -->
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MailChannels.EmailApi</AssemblyName>
    <PackageId>MailChannels.EmailApi</PackageId>
    <OutputType>Library</OutputType>
    <Authors>MailChannels</Authors>
    <Company>MailChannels</Company>
    <AssemblyTitle>MailChannels Email API SDK</AssemblyTitle>
    <Description>Server-side .NET client for all MailChannels Email API operations. Support: dev@mailchannels.com. Unreleased candidate.</Description>
    <Copyright>Copyright (c) 2026 MailChannels</Copyright>
    <RootNamespace>MailChannels.EmailApi</RootNamespace>
    <Version>0.1.0-alpha.1</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\MailChannels.EmailApi.xml</DocumentationFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/GIT_USER_ID/GIT_REPO_ID.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Unreleased evaluation candidate; not published to NuGet.org.</PackageReleaseNotes>
    <PackageTags>mailchannels email transactional email-api</PackageTags>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.20" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Condition="'$(TargetFramework)' == 'net8.0'" Version="8.0.17" />
  </ItemGroup>

  <PropertyGroup>
    <RepositoryUrl>https://github.com/mailchannels/mailchannels-email-api-sdk-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://docs.mailchannels.com/email-api/</PackageProjectUrl>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../PACKAGE_README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
